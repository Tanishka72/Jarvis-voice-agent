# ---------------- Gemini API keys ----------------
# Get keys at https://aistudio.google.com/apikey  (a correct key starts with "AIza")
# IMPORTANT: create each key in a DIFFERENT Google Cloud project
# ("Create API key in new project"). Keys in the same project share one limit.
# When a key hits its limit, Jarvis automatically moves on to the next one.
# Leave unused slots empty.
GEMINI_API_KEY_1=your_first_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=

# ---------------- Settings ----------------
# Wake word name: you'll say "Hey Jarvis"
AGENT_NAME=Jarvis

# City to use when you ask for weather without naming one
DEFAULT_CITY=Mumbai

# Gemini model to try first (backups are used automatically when it's busy)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: microphone sensitivity. Lower = hears quieter voices (try 400-800).
# Leave empty to calibrate automatically.
MIC_THRESHOLD=
